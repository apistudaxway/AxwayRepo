{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "System": "Information",
      "Microsoft": "Information",
      "Microsoft.Graph": "Debug",
      "GraphUserManagement": "Debug"
    }
  },
  "GraphApi": {
    "TenantId": "your-development-tenant-id",
    "ClientId": "your-development-client-id",
    "ClientSecret": "your-development-client-secret",
    "BaseUrl": "https://graph.microsoft.com",
    "Scopes": "https://graph.microsoft.com/.default",
    "TimeoutInSeconds": 30
  },
  "JwtSettings": {
    "SecretKey": "DevelopmentSecretKeyThatIsAtLeast32CharactersLong!",
    "Issuer": "GraphUserManagementAPI-Dev",
    "Audience": "GraphUserManagementAPI-Dev",
    "ExpiryInMinutes": 120
  }
}
